local WeatherTypes = require(script.Parent.Parent.Types.WeatherTypes)

type EnvironmentPreset = {
	Brightness: number,
	Ambient: Color3,
	AtmosphereDensity: number,
	CloudCover: number,
	Wind: Vector3,
	RainRate: number,
	SnowRate: number,
	Temperature: number,
	Sunshine: number,
	CloudDensity: number,
	CloudColor: Color3,
	AtmosphereHaze: number,
}

local function environment(preset: EnvironmentPreset): WeatherTypes.Environment
	return {
		Brightness = preset.Brightness,
		ExposureCompensation = 0,
		Ambient = preset.Ambient,
		OutdoorAmbient = preset.Ambient,
		AtmosphereDensity = preset.AtmosphereDensity,
		AtmosphereOffset = 0.1,
		AtmosphereColor = Color3.fromRGB(200, 210, 225),
		AtmosphereDecay = Color3.fromRGB(100, 110, 130),
		AtmosphereGlare = 0,
		AtmosphereHaze = preset.AtmosphereHaze,
		CloudCover = preset.CloudCover,
		CloudDensity = preset.CloudDensity,
		CloudColor = preset.CloudColor,
		Wind = preset.Wind,
		RainRate = preset.RainRate,
		SnowRate = preset.SnowRate,
		Temperature = preset.Temperature,
		Sunshine = preset.Sunshine,
	}
end

